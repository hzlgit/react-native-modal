  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "^18.3.0",
    "husky": "^3.0.9",
    "postinstall": "^0.5.1",
    "prettier": "2.8.8",
    "pretty-quick": "^2.0.0",
    "react": "18.3.1",
